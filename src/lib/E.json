          "definition": "To put into disorder.",
          "ilok_example": "Saan mo nga guloen daytoy grupo mi.",
          "eng_example": "Don’t put our group into disorder."
        },
        {
          "root": "kudit",
          "derivative": "kuditen",
          "definition": "To do, work on, touch.",
          "ilok_example": "Adu ti kinudit na isu nga nabannog.",
          "eng_example": "He did/worked on many things, so he is tired."
        },
        {
          "root": "ladingit",
          "derivative": "ladingeten",
          "definition": "To be sad or mournful about, to grieve for, mourn for; to be sorry for.",
          "ilok_example": "Ladingetek ti napasamak kenka.",
          "eng_example": "I am sorry for what happened to you."
