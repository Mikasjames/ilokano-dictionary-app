  "-EN": [
    {
      "part_of_speech": "suf.",
      "definition": "A passive verbalizing suffix which generally places the goal of the verb in focus or subject position.",
      "origin": "pt. -IN-, prp. R1 + -EN, ptp. R1 + -IN-",
      "examples": [
        {
          "root": "bado",
          "derivative": "badoen",
          "definition": "To wear (a dress/clothes).",
          "ilok_example": "Badoen da diay lupot nga inted mo.",
          "eng_example": "They will wear the clothes that you gave."
        },
        {
          "root": "bangon",
          "derivative": "ibangon",
          "definition": "To erect, build, construct.",
          "ilok_example": "Isuda ti nangbangon toy balay mi.",
          "eng_example": "It was they who constructed this house of ours."
        },
        {
          "root": "batok",
          "derivative": "ibatok",
          "definition": "To dive into or go under the water with (something or someone) in order to deliver or retrieve it.",
